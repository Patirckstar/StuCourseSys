<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stucoursesys.mapper.StudentMapper">

    <select id="findAll" resultType="com.stucoursesys.entity.Student">
        SELECT student_no, name, class_name
        FROM student
        ORDER BY student_no
    </select>

    <select id="findByStudentNo" resultType="com.stucoursesys.entity.Student">
        SELECT student_no, name, class_name
        FROM student
        WHERE student_no = #{studentNo}
    </select>

</mapper>
