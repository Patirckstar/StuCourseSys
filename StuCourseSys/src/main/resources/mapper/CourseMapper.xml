<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.stucoursesys.mapper.CourseMapper">

    <select id="findAll" resultType="com.stucoursesys.entity.Course">
        SELECT course_id, course_name, credit
        FROM course
        ORDER BY course_id
    </select>

    <select id="findByCourseId" resultType="com.stucoursesys.entity.Course">
        SELECT course_id, course_name, credit
        FROM course
        WHERE course_id = #{courseId}
    </select>

</mapper>
